# ---------------------------------------------------------------------------
# Database (Prisma 7 + SQLite, local file)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# Session Secret (required for production SIWE sessions, >= 32 chars)
# ---------------------------------------------------------------------------
SESSION_SECRET="your-at-least-32-character-session-secret-here-for-siwe"

# ---------------------------------------------------------------------------
# NEAR AI Cloud (optional — the app runs with deterministic fallback without it)
# Get a key at https://cloud.near.ai
# ---------------------------------------------------------------------------
NEARAI_API_KEY=
NEAR_AI_MODEL="z-ai/glm-5.3-flash"
NEAR_AI_BASE_URL="https://cloud-api.near.ai/v1"

# ---------------------------------------------------------------------------
# RPC (optional — public endpoints with rotation fallback used when empty)
# ---------------------------------------------------------------------------
RPC_URL_BASE=
RPC_URL_ARBITRUM=

# ---------------------------------------------------------------------------
# NEAR Intents 1Click (optional — public, unauthenticated quotes work)
# Without a JWT the API applies its unauthenticated fee schedule.
# ---------------------------------------------------------------------------
ONECLICK_JWT=
ONECLICK_BASE_URL="https://1click.chaindefuser.com"

# ---------------------------------------------------------------------------
# Execution Limits & Guardrails
# ---------------------------------------------------------------------------
EXECUTION_MAX_MOVE_USDC="50"
EXECUTION_MAX_DAILY_USDC="100"
EXECUTION_DISABLED="false"

# ---------------------------------------------------------------------------
# Runtime Data Mode
# sample  = fixture portfolio, clearly labelled, no wallet needed
# dry_run = live reads, live quotes, no funds move
# live    = real wallet signing and real deposits on mainnet
# ---------------------------------------------------------------------------
APP_DATA_MODE="live"
