# ---------------------------------------------------------------------------
# Database (Prisma 7 + SQLite, local file)
# ---------------------------------------------------------------------------
DATABASE_URL="file:./prisma/dev.db"

# ---------------------------------------------------------------------------
# NEAR AI Cloud (optional — the app runs without it)
# Get a key at https://cloud.near.ai (free credits via https://nearbuilders.org/join)
# ---------------------------------------------------------------------------
NEARAI_API_KEY=
NEAR_AI_MODEL="z-ai/glm-5.3-flash"
NEAR_AI_BASE_URL="https://cloud-api.near.ai/v1"

# ---------------------------------------------------------------------------
# RPC (optional — public endpoints are used when empty)
# ---------------------------------------------------------------------------
RPC_URL_BASE=
RPC_URL_ARBITRUM=

# ---------------------------------------------------------------------------
# NEAR Intents 1Click (optional — public, unauthenticated quotes work)
# Without a JWT the API applies its unauthenticated fee schedule.
# ---------------------------------------------------------------------------
ONECLICK_JWT=
ONECLICK_BASE_URL="https://1click.chaindefuser.com"

# ---------------------------------------------------------------------------
# Runtime
# sample  = fixture portfolio, clearly labelled, no wallet needed (default)
# dry_run = live reads, live quotes, no funds move
# live    = real wallet signing and real deposits
# ---------------------------------------------------------------------------
APP_DATA_MODE="sample"
